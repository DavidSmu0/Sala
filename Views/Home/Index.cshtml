@{
    ViewData["Title"] = "Home Page";
}

<div class="conteiner-fluid">
    <div class="row">
        <div class="col-12 col-md-12 text-center">
            <img id="sali" src="/img/sali.png" alt="">
        </div>
    </div>
</div>

<div class="conteiner-fluid" style="margin: 30px;">
    <div class="row">
        <div class="col-6 col-md-6 text-center">
            <img class="estadio" src="/img/estadio.png" alt="">
        </div>

        <div class="col-6 col-md-6 text-center">
            <h3 class="txt" id="instrucciones">INSTRUCCIONES</h3>
            <h5 class="instru-txt txt" >El objetivo del juego es salir del Estadio. Para ello deberás responder todas las preguntas bien para salir. Solo puedees pedir 2 pistas.<h5 class="instru-txt">A ¡Divertirse!</h5></h5>
            <br>
            <a asp-controller="Home" asp-action="PrimerPregunta" ><img id="play" src="/img/Play.png" alt=""></a>
        
        </div>
    </div>
</div>

<div class="conteiner-fluid">
    <div class="row">
        <div class="col-12 col-md-1">
            &nbsp;
        </div>

        <div class="col-12 col-md-10 text-center">
            <div >
                <h6 id="hist">En "Escape del Coloso", te sumergirás en una experiencia única en el estadio de Newell's Old Boys. Imagina estar atrapado en el césped legendario y las gradas icónicas del Estadio Marcelo Bielsa. Tu equipo y tú deberán resolver enigmas y superar desafíos relacionados con la historia del club y momentos emblemáticos del fútbol para escapar.</h6>
            </div>
        </div>

        <div class="col-12 col-md-1">
            &nbsp;
        </div>

    </div>
</div>

